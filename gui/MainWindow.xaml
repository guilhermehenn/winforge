<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge" Width="1060" Height="720" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#0F1419" Foreground="#E6EDF3"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Botao da barra lateral -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C9D4E0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,10">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cartao de acao -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Background" Value="#161D27"/>
      <Setter Property="BorderBrush" Value="#263241"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Width" Value="276"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="Bd" Property="Background" Value="#1B2531"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chave liga/desliga (ajustes do Windows) -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#2B3748" BorderBrush="Transparent" BorderThickness="1">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#C9D4E0" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#3B82F6"/>
                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botao em pilula -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="Background" Value="#1F2A38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barra lateral -->
    <Border Grid.Column="0" Background="#0B0F14" Padding="14,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <!-- O logotipo (assets/WinForge.ico) so aparece depois de carregado pelo script -->
          <Image x:Name="LogoImage" Width="38" Height="38" Margin="0,0,10,0" Visibility="Collapsed"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WinForge" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="BuildText" Text="" Foreground="#6B7C90" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="#1A222D" Margin="6,6,6,6"/>
          <!-- Paginas com Placement = Footer (Sobre o WinForge) -->
          <StackPanel x:Name="FooterNav"/>
          <TextBlock x:Name="AdminText" Foreground="#6B7C90" FontSize="11" Margin="14,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="NavPanel"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,22,20,16">
      <!-- Paginas (cartoes, ajustes, inicio) -->
      <Grid x:Name="PagesView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
          <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Foreground="#8A9BB0" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>
      </Grid>

      <!-- Execucao: saida, progresso e perguntas -->
      <Grid x:Name="RunView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StopButton" Style="{StaticResource PillButton}" Content="Parar" Background="#7F1D1D"/>
            <Button x:Name="CopyButton" Style="{StaticResource PillButton}" Content="Copiar saída"/>
            <Button x:Name="BackButton" Style="{StaticResource PillButton}" Content="Voltar" Background="#3B82F6" Visibility="Collapsed" Margin="0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="RunTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Ellipse x:Name="RunDot" Width="9" Height="9" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="RunStatus" Foreground="#8A9BB0"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#0B0F14" BorderBrush="#263241" BorderThickness="1" CornerRadius="10">
          <RichTextBox x:Name="OutputBox" Background="Transparent" BorderThickness="0" Foreground="#C9D4E0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5" IsReadOnly="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10"/>
        </Border>
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBlock x:Name="ProgressText" Foreground="#8A9BB0" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="100" Background="#1F2A38" Foreground="#3B82F6" BorderThickness="0" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="3" x:Name="PromptBar" Visibility="Collapsed" Margin="0,10,0,0" Background="#161D27"
                BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer x:Name="PromptListScroll" MaxHeight="230" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,10">
              <StackPanel x:Name="PromptList"/>
            </ScrollViewer>
            <DockPanel x:Name="PromptTextRow" Margin="0,0,0,8">
              <Button x:Name="PromptSend" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Enviar" Background="#3B82F6" Margin="10,0,0,0"/>
              <TextBox x:Name="PromptInput" Background="#0B0F14" Foreground="#E6EDF3" CaretBrush="White" BorderBrush="#263241"
                       Padding="8,6" FontFamily="Cascadia Mono, Consolas" FontSize="13"/>
            </DockPanel>
            <WrapPanel x:Name="PromptButtons"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
