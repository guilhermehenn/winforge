# Quebras de linha CRLF nos arquivos do projeto (o cmd.exe e o Windows PowerShell 5.1 esperam isso).
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.xaml  text eol=crlf
*.md    text eol=crlf
*.yml   text eol=crlf
*.json  text eol=crlf
*.svg   text eol=crlf

# O ícone é binário: nenhuma conversão de quebra de linha.
*.ico   binary

